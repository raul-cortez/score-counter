# Скопировать в .env рядом с compose.yaml и вписать свой домен.
#
#   cp .env.example .env

# Домен, на котором будет жить приложение. Должен указывать A-записью на эту
# машину — иначе Let's Encrypt не сможет выдать сертификат.
DOMAIN=score.example.com

# Версия образа. latest — всегда свежая; можно указать конкретный sha-тег,
# чтобы зафиксировать версию или откатиться.
TAG=latest
