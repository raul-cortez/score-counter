# Скопировать в .env рядом с compose.yaml и вписать свой домен.
#
#   cp .env.example .env

# Домен, на котором будет жить приложение. Должен указывать A-записью на эту
# машину — иначе Let's Encrypt не сможет выдать сертификат.
DOMAIN=score.example.com

# Версия образа. latest — всегда свежая; можно указать конкретный sha-тег,
# чтобы зафиксировать версию или откатиться.
TAG=latest

# --- только для compose.traefik.yaml ---
# Нужно, когда 80 и 443 на машине уже заняты чужим Traefik и свой Caddy не поднять.
#
# Сеть, в которой живёт Traefik. У Coolify — `coolify`.
# Посмотреть: docker inspect <traefik> --format '{{json .NetworkSettings.Networks}}'
PROXY_NETWORK=coolify
# Точка входа Traefik для HTTPS. У Coolify она называется `https`,
# у самостоятельного Traefik чаще `websecure` — посмотрите в его аргументах:
# docker inspect <traefik> --format '{{json .Config.Cmd}}' | grep entrypoints
TRAEFIK_ENTRYPOINT=https
