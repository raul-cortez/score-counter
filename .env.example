# Скопировать в .env рядом с compose.yaml на сервере.
# В репозиторий .env не коммитится.

# Домен приложения.
DOMAIN=score.fastio.ru

# --- только для compose.traefik.yaml ---
# Сеть, в которой живёт Traefik. У Coolify обычно `coolify`.
# Посмотреть: docker inspect <traefik> --format '{{json .NetworkSettings.Networks}}'
PROXY_NETWORK=coolify
# Точка входа Traefik для HTTPS. Обычно websecure.
TRAEFIK_ENTRYPOINT=websecure

# --- только для compose.port.yaml ---
# Порт на петле, куда будет ходить прокси хоста.
HOST_PORT=3000

# Метка образа. Пригодится, чтобы откатиться на предыдущую сборку.
TAG=latest
